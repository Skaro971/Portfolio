---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Portfolio - Découvrez mes projets" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1a1a2e" />
    <title>{title} | Portfolio</title>
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --primary: #0f3460;
        --secondary: #16213e;
        --accent: #00d4ff;
        --text: #eaeaea;
        --text-muted: #a8a8a8;
      }

      html {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: var(--secondary);
        color: var(--text);
      }

      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        line-height: 1.6;
      }

      main {
        flex: 1;
      }

      a {
        color: var(--accent);
        text-decoration: none;
        transition: color 0.3s ease;
      }

      a:hover {
        color: #00b4d4;
      }

      h1, h2, h3 {
        color: var(--text);
        margin-bottom: 1rem;
      }

      h1 {
        font-size: 2.5rem;
      }

      h2 {
        font-size: 2rem;
      }

      h3 {
        font-size: 1.5rem;
      }

      @media (max-width: 768px) {
        h1 {
          font-size: 1.8rem;
        }
        h2 {
          font-size: 1.5rem;
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>