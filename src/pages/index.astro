---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Footer from '../components/Footer.astro';

const projects = [
  {
    title: "Asset Engine",
    description: "Système d'archivage binaire avec gestion CRUD, vérification d'intégrité et chiffrement.",
    tags: ["C++17", "STL", "Binaire", "CLI", "CRC32", "Chiffrement"],
    link: "/Portfolio/projects/asset-engine",
    image: ""
  },
  {
    title: "Multithreading Battle Royale",
    description: "Simulation haute performance de 17 000 entités en temps réel avec traitement parallèle.",
    tags: ["C++", "Multithreading", "Windows API", "SFML", "CMake", "Temps réel"],
    link: "/Portfolio/projects/multithreading",
    image: ""
  },
  {
    title: "Audio Editor",
    description: "Éditeur audio avec parsing binaire natif, traitement de signal et visualisation de données.",
    tags: ["C++", "Audio", "WAV", "Waveform", "CMake", "Sérialisation"],
    link: "/Portfolio/projects/audio-editor",
    image: ""
  },
  {
    title: "Web Home",
    description: "Extension Chrome de nouvel onglet personnalisable avec 9 widgets, 5 thèmes et 6 fonds animés.",
    tags: ["JavaScript", "Vite", "Chrome Extension", "Gridstack.js", "Canvas API"],
    link: "/Portfolio/projects/web-home",
    image: ""
  }
];
---

<Layout title="Skaro971">
  <Header />
  <main>
    <HeroSection />

    <section id="projects" class="projects-section">
      <div class="container">
        <h2 class="section-title">Mes Projets</h2>
        <p class="section-subtitle">Voici quelques projets sur lesquels j'ai travaillé</p>
        <div class="projects-grid">
          {projects.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              tags={project.tags}
              link={project.link}
              image={project.image}
            />
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="contact-section">
      <div class="container">
        <h2 class="section-title">Me Contacter</h2>
        <div class="contact-content">
          <a href="mailto:willemgironsdp@gmail.com" class="contact-btn contact-btn--cyan">Envoyer un email</a>
          <a href="https://github.com/Skaro971" target="_blank" class="contact-btn contact-btn--violet">Voir GitHub</a>
          <a href="https://www.linkedin.com/in/willem-giron-69075829a/" target="_blank" class="contact-btn contact-btn--red">LinkedIn</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-title {
  display: block;
  text-align: center;
  font-size: 1.6rem;
  color: var(--text-bright);
  margin-bottom: 0.5rem;
  position: relative;
}

.section-title::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 50%;
  transform: translateX(-50%);
  width: 40px;
  height: 1px;
  background: linear-gradient(90deg, var(--cyan), var(--violet));
}

  /* Projets */
  .projects-section {
    padding: 5rem 2rem;
    background-color: var(--bg);
    text-align: center;
  }

  .section-subtitle {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 3rem;
    margin-top: 1rem;
    letter-spacing: 0.04em;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    text-align: left;
  }

  /* Contact */
  .contact-section {
    padding: 5rem 2rem;
    background-color: var(--surface);
    text-align: center;
    border-top: 1px solid var(--border);
    position: relative;
  }

  .contact-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--violet), var(--cyan), var(--red), transparent);
    opacity: 0.4;
  }

  .contact-content {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .contact-btn {
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.8rem 1.8rem;
    border-radius: 2px;
    transition: all 0.2s ease;
    display: inline-block;
  }

  .contact-btn--cyan {
    background: var(--cyan-dim);
    color: var(--cyan);
    border: 1px solid rgba(0, 229, 255, 0.35);
  }

  .contact-btn--cyan:hover {
    background: var(--cyan);
    color: #000;
    box-shadow: 0 0 20px rgba(0, 229, 255, 0.4);
  }

  .contact-btn--violet {
    background: var(--violet-dim);
    color: var(--violet);
    border: 1px solid rgba(184, 0, 255, 0.35);
  }

  .contact-btn--violet:hover {
    background: var(--violet);
    color: #fff;
    box-shadow: 0 0 20px rgba(184, 0, 255, 0.4);
  }

  .contact-btn--red {
    background: var(--red-dim);
    color: var(--red);
    border: 1px solid rgba(255, 42, 74, 0.35);
  }

  .contact-btn--red:hover {
    background: var(--red);
    color: #fff;
    box-shadow: 0 0 20px rgba(255, 42, 74, 0.4);
  }

  @media (max-width: 768px) {
    .projects-section,
    .contact-section { padding: 3rem 1rem; }
    .projects-grid { grid-template-columns: 1fr; }
    .contact-content { flex-direction: column; }
    .contact-btn { width: 100%; text-align: center; }
  }
</style>