---
interface Props {
  title: string;
  description: string;
  tags: string[];
  link?: string;
  image?: string;
  video?: string;
}
const { title, description, tags, link = "#", image, video } = Astro.props;
---

<a href={link} class="card-link">
  <article class="card">
    <div class="card-media">
      {video ? (
        <video autoplay loop muted playsinline class="card-media-content">
          <source src={video} type="video/mp4" />
        </video>
      ) : image ? (
        <img src={image} alt={title} class="card-media-content" />
      ) : (
        <div class="card-placeholder">
          <div class="pulse-bars">
            <span></span><span></span><span></span><span></span><span></span>
          </div>
        </div>
      )}
    </div>

    <div class="card-body">
      <h3>{title}</h3>
      <p>{description}</p>
      <div class="card-tags">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
      <span class="card-cta">Voir le projet →</span>
    </div>

    <span class="corner corner-tl"></span>
    <span class="corner corner-br"></span>
  </article>
</a>

<style>
  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .card {
    position: relative;
    background-color: var(--surface);
    border: 1px solid rgba(0, 229, 255, 0.12);
    border-radius: 3px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
  }

  .card-link:hover .card {
    border-color: rgba(0, 229, 255, 0.45);
    box-shadow:
      0 0 25px rgba(0, 229, 255, 0.08),
      0 0 50px rgba(184, 0, 255, 0.05),
      0 8px 30px rgba(0, 0, 0, 0.4);
    transform: translateY(-5px);
  }

  /* Coins décoratifs violet au hover */
  .corner {
    position: absolute;
    width: 14px;
    height: 14px;
    opacity: 0;
    transition: opacity 0.25s;
  }

  .corner-tl {
    top: -1px; left: -1px;
    border-top: 2px solid var(--violet);
    border-left: 2px solid var(--violet);
  }

  .corner-br {
    bottom: -1px; right: -1px;
    border-bottom: 2px solid var(--red);
    border-right: 2px solid var(--red);
  }

  .card-link:hover .corner { opacity: 1; }

  /* Media */
  .card-media {
    width: 100%;
    height: 180px;
    overflow: hidden;
    flex-shrink: 0;
    background-color: var(--surface-2);
    border-bottom: 1px solid rgba(0, 229, 255, 0.08);
  }

  .card-media-content {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .card-link:hover .card-media-content { transform: scale(1.05); }

  .card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pulse-bars {
    display: flex;
    align-items: flex-end;
    gap: 5px;
    height: 44px;
  }

  .pulse-bars span {
    display: block;
    width: 3px;
    border-radius: 1px;
    animation: pulse 1.8s ease-in-out infinite;
  }

  .pulse-bars span:nth-child(1) { height: 30%; background: var(--cyan);   animation-delay: 0.0s; }
  .pulse-bars span:nth-child(2) { height: 75%; background: var(--violet); animation-delay: 0.2s; }
  .pulse-bars span:nth-child(3) { height: 50%; background: var(--cyan);   animation-delay: 0.4s; }
  .pulse-bars span:nth-child(4) { height: 90%; background: var(--red);    animation-delay: 0.6s; }
  .pulse-bars span:nth-child(5) { height: 40%; background: var(--violet); animation-delay: 0.8s; }

  @keyframes pulse {
    0%, 100% { opacity: 0.2; transform: scaleY(0.8); }
    50%       { opacity: 0.8; transform: scaleY(1); }
  }

  /* Body */
  .card-body {
    padding: 1.4rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-body h3 {
    font-size: 1rem;
    letter-spacing: 0.06em;
    color: var(--text-bright);
    margin-bottom: 0.6rem;
    transition: color 0.2s;
  }

  .card-link:hover .card-body h3 { color: var(--cyan); }

  .card-body p {
    font-size: 0.875rem;
    color: var(--text);
    line-height: 1.65;
    margin-bottom: 1.2rem;
    flex: 1;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.1rem;
  }

  .tag {
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.68rem;
    color: var(--cyan);
    border: 1px solid rgba(0, 229, 255, 0.2);
    background: rgba(0, 229, 255, 0.05);
    padding: 0.2rem 0.55rem;
    border-radius: 1px;
    letter-spacing: 0.05em;
  }

  .card-cta {
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    transition: color 0.2s, letter-spacing 0.2s;
    display: inline-block;
  }

  .card-link:hover .card-cta {
    color: var(--cyan);
    letter-spacing: 0.16em;
  }
</style>