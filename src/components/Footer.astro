<style>
  footer {
    background-color: var(--primary);
    border-top: 2px solid var(--accent);
    margin-top: 4rem;
    padding: 2rem 0 1rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .footer-section h4 {
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .footer-section p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .footer-section ul {
    list-style: none;
  }

  .footer-section ul li {
    margin-bottom: 0.5rem;
  }

  .footer-section a {
    color: var(--text-muted);
    transition: color 0.3s ease;
  }

  .footer-section a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    text-align: center;
    padding-top: 2rem;
    border-top: 1px solid rgba(0, 212, 255, 0.1);
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>