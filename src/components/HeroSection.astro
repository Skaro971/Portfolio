---
---
<section class="hero">
  <div class="hero-grid"></div>
  <div class="hero-glow-cyan"></div>
  <div class="hero-glow-violet"></div>
  <div class="container">
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="glitch" data-text="Willem Giron">Willem Giron</span>
      </h1>
      <p class="hero-subtitle">
        Développeur C++ — systèmes bas niveau, performance, architecture logicielle.
      </p>
      <div class="hero-buttons">
        <a href="#projects" class="btn btn-primary">Découvrir mes projets</a>
        <a href="#contact" class="btn btn-secondary">Me contacter</a>
      </div>
    </div>
  </div>
</section>

<section class="about">
  <div class="container">
    <div class="about-content">
      <div class="about-text">
        <h2 class="section-title">À propos</h2>
        <p>
          Étudiant en 4ème année à la G.Tech de Gaming Campus, je conçois des systèmes
          logiciels robustes et performants | de la gestion de ressources binaires au
          traitement parallèle en temps réel.
        </p>
        <p>
          Au-delà du bas niveau, je m'intéresse à la façon dont les données circulent,
          sont structurées et exploitées | un fil conducteur qui traverse tous mes projets,
          de la sérialisation à la visualisation.
        </p>
      </div>
      <div class="about-stack">
        <h2 class="section-title">Stack</h2>
        <div class="stack-grid">
          <div class="stack-category">
            <span class="category-label">Langages</span>
            <div class="stack-items">
              <span class="stack-item">C++</span>
              <span class="stack-item">Python</span>
              <span class="stack-item">SQL</span>
              <span class="stack-item">HTML/CSS</span>
            </div>
          </div>
          <div class="stack-category">
            <span class="category-label">Systèmes</span>
            <div class="stack-items">
              <span class="stack-item stack-item--violet">Windows API</span>
              <span class="stack-item stack-item--violet">Multithreading</span>
              <span class="stack-item stack-item--violet">CMake</span>
            </div>
          </div>
          <div class="stack-category">
            <span class="category-label">Outils</span>
            <div class="stack-items">
              <span class="stack-item stack-item--red">Git</span>
              <span class="stack-item stack-item--red">Visual Studio</span>
              <span class="stack-item stack-item--red">SFML</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* HERO */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 4rem 2rem;
    overflow: hidden;
    background-color: var(--bg);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0, 229, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 229, 255, 0.06) 1px, transparent 1px);
    background-size: 50px 50px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 100%);
  }

  .hero-glow-cyan {
    position: absolute;
    top: 40%;
    left: 35%;
    transform: translate(-50%, -50%);
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 229, 255, 0.07) 0%, transparent 65%);
    pointer-events: none;
  }

  .hero-glow-violet {
    position: absolute;
    top: 55%;
    left: 65%;
    transform: translate(-50%, -50%);
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(184, 0, 255, 0.07) 0%, transparent 65%);
    pointer-events: none;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .hero-content {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  /* Glitch */
  .glitch {
    position: relative;
    display: inline-block;
    color: var(--text-bright);
  }

  .glitch::before,
  .glitch::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    color: var(--text-bright);
    opacity: 0;
  }

  .glitch::before {
    color: var(--violet);
    clip-path: polygon(0 25%, 100% 25%, 100% 45%, 0 45%);
    animation: glitch-a 5s infinite;
  }

  .glitch::after {
    color: var(--cyan);
    clip-path: polygon(0 60%, 100% 60%, 100% 78%, 0 78%);
    animation: glitch-b 5s infinite;
  }

  @keyframes glitch-a {
    0%, 88%, 100% { opacity: 0; transform: translateX(0); }
    90%           { opacity: 0.8; transform: translateX(-5px); }
    92%           { opacity: 0.8; transform: translateX(5px); }
    94%           { opacity: 0; }
  }

  @keyframes glitch-b {
    0%, 88%, 100% { opacity: 0; transform: translateX(0); }
    91%           { opacity: 0.7; transform: translateX(5px); }
    93%           { opacity: 0.7; transform: translateX(-5px); }
    95%           { opacity: 0; }
  }

  .hero-title {
    font-size: clamp(3rem, 9vw, 5.5rem);
    margin-bottom: 1.5rem;
    line-height: 1.1;
    /* Pas de gradient clip — titre toujours visible */
    color: var(--text-bright);
    text-shadow:
      0 0 30px rgba(0, 229, 255, 0.3),
      0 0 60px rgba(0, 229, 255, 0.1);
  }

  .hero-subtitle {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 3rem;
    font-weight: 300;
    letter-spacing: 0.04em;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.8rem 2rem;
    border-radius: 2px;
    transition: all 0.2s ease;
    display: inline-block;
  }

  .btn-primary {
    background-color: var(--cyan);
    color: #000;
    box-shadow: 0 0 20px rgba(0, 229, 255, 0.3);
  }

  .btn-primary:hover {
    background-color: var(--violet);
    color: #fff;
    box-shadow: 0 0 25px rgba(184, 0, 255, 0.5);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--text-bright);
    border: 1px solid rgba(0, 229, 255, 0.35);
  }

  .btn-secondary:hover {
    border-color: var(--red);
    color: var(--red);
    box-shadow: 0 0 20px rgba(255, 42, 74, 0.25);
  }

  /* ABOUT */
  .about {
    background-color: var(--surface);
    padding: 5rem 2rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    position: relative;
  }

  .about::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--cyan), var(--violet), var(--red), transparent);
    opacity: 0.5;
  }

  .about-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .section-title {
    font-size: 1.4rem;
    margin-bottom: 1.4rem;
    color: var(--text-bright);
    position: relative;
    padding-bottom: 0.6rem;
  }

  .section-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 40px;
    height: 1px;
    background: linear-gradient(90deg, var(--cyan), var(--violet));
  }

  .about-text p {
    color: var(--text);
    line-height: 1.8;
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .stack-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .stack-category {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .category-label {
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.68rem;
    color: var(--text-muted);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .stack-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .stack-item {
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.78rem;
    color: var(--cyan);
    border: 1px solid rgba(0, 229, 255, 0.25);
    background: var(--cyan-dim);
    padding: 0.25rem 0.65rem;
    border-radius: 2px;
    letter-spacing: 0.05em;
    transition: all 0.2s;
    cursor: default;
  }

  .stack-item:hover {
    background: rgba(0, 229, 255, 0.2);
    border-color: var(--cyan);
    box-shadow: 0 0 10px rgba(0, 229, 255, 0.3);
  }

  .stack-item--violet {
    color: var(--violet);
    border-color: rgba(184, 0, 255, 0.25);
    background: var(--violet-dim);
  }

  .stack-item--violet:hover {
    background: rgba(184, 0, 255, 0.2);
    border-color: var(--violet);
    box-shadow: 0 0 10px rgba(184, 0, 255, 0.3);
  }

  .stack-item--red {
    color: var(--red);
    border-color: rgba(255, 42, 74, 0.25);
    background: var(--red-dim);
  }

  .stack-item--red:hover {
    background: rgba(255, 42, 74, 0.2);
    border-color: var(--red);
    box-shadow: 0 0 10px rgba(255, 42, 74, 0.3);
  }

  @media (max-width: 768px) {
    .hero { min-height: 80vh; padding: 3rem 1rem; }
    .hero-buttons { flex-direction: column; }
    .btn { width: 100%; text-align: center; }
    .about { padding: 3rem 1rem; }
    .about-content { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>